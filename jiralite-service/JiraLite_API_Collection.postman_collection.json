{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "JiraLite API Collection",
		"description": "Колекція тестів для JiraLite Service API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health Check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has status UP\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"UP\");",
							"});",
							"",
							"pm.test(\"Response contains service info\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.service).to.eql(\"JiraLite Service API\");",
							"    pm.expect(jsonData.version).to.eql(\"1.0.0-SNAPSHOT\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/health",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "health"]
				}
			},
			"response": []
		},
		{
			"name": "Create Issue",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Issue created successfully\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.id).to.be.a('number');",
							"    pm.expect(jsonData.title).to.eql(\"Test Issue\");",
							"    pm.expect(jsonData.description).to.eql(\"This is a test issue\");",
							"    pm.expect(jsonData.priority).to.eql(\"HIGH\");",
							"    pm.expect(jsonData.status).to.eql(\"OPEN\");",
							"});",
							"",
							"pm.test(\"Issue has timestamps\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.createdAt).to.not.be.null;",
							"});",
							"",
							"// Сохраняем ID созданной задачи для следующих тестов",
							"pm.test(\"Save issue ID\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.globals.set(\"issueId\", jsonData.id);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Test Issue\",\n    \"description\": \"This is a test issue\",\n    \"priority\": \"HIGH\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/issue",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["issue"]
				}
			},
			"response": []
		},
		{
			"name": "Get Issue by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Issue retrieved successfully\", function () {",
							"    var jsonData = pm.response.json();",
							"    var expectedId = parseInt(pm.globals.get(\"issueId\"));",
							"    pm.expect(jsonData.id).to.eql(expectedId);",
							"    pm.expect(jsonData.title).to.eql(\"Test Issue\");",
							"    pm.expect(jsonData.description).to.eql(\"This is a test issue\");",
							"    pm.expect(jsonData.priority).to.eql(\"HIGH\");",
							"    pm.expect(jsonData.status).to.eql(\"OPEN\");",
							"});",
							"",
							"pm.test(\"Issue has correct structure\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('title');",
							"    pm.expect(jsonData).to.have.property('description');",
							"    pm.expect(jsonData).to.have.property('priority');",
							"    pm.expect(jsonData).to.have.property('status');",
							"    pm.expect(jsonData).to.have.property('createdAt');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/issue/{{issueId}}",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["issue", "{{issueId}}"]
				}
			},
			"response": []
		},
		{
			"name": "Get Non-Existent Issue",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 404\", function () {",
							"    pm.response.to.have.status(404);",
							"});",
							"",
							"pm.test(\"Response body is empty\", function () {",
							"    pm.expect(pm.response.text()).to.be.empty;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/issue/999999",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["issue", "999999"]
				}
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [""]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [""]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	]
}
