@startuml sequence_login
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Arial

title Діаграма послідовності: Процес авторизації

actor User as user
participant "Launcher" as launcher
participant "LoginFrame" as loginFrame
participant "AuthService" as authService
participant "UserMemoryRepository" as userRepo
participant "MainFrame" as mainFrame
participant "BoardService" as boardService

user -> launcher : Запуск програми
activate launcher

launcher -> loginFrame : new LoginFrame(authService)
activate loginFrame

launcher -> loginFrame : setVisible(true)
loginFrame -> user : Показати форму входу

user -> loginFrame : Ввести логін/пароль
user -> loginFrame : Натиснути "Увійти" або Enter

loginFrame -> loginFrame : Валідація полів
alt Поля порожні
    loginFrame -> user : Показати помилку "Введіть дані"
else Поля заповнені
    loginFrame -> authService : signIn(login, password)
    activate authService
    
    authService -> userRepo : findByLogin(login)
    activate userRepo
    
    note right of userRepo : Пошук серед тестових користувачів:\nadmin/qwerty (ADMIN)\njohn/1234 (USER)\nguest/guest (GUEST)
    
    userRepo --> authService : User або null
    deactivate userRepo
    
    alt Користувач не знайдений
        authService --> loginFrame : AuthException("Невірний логін")
        loginFrame -> user : Показати помилку
    else Користувач знайдений
        authService -> authService : Перевірити пароль
        
        alt Пароль невірний
            authService --> loginFrame : AuthException("Невірний пароль")
            loginFrame -> user : Показати помилку
        else Пароль вірний
            authService -> authService : setCurrentUser(user)
            authService -> userRepo : updateLastLogin()
            authService --> loginFrame : User
            deactivate authService
            
            loginFrame -> loginFrame : dispose()
            
            loginFrame -> mainFrame : new MainFrame(boardService, messages, user)
            activate mainFrame
            
            loginFrame -> mainFrame : setVisible(true)
            mainFrame -> user : Показати головне вікно
            
            mainFrame -> boardService : getUserProjects()
            activate boardService
            boardService -> userRepo : findByProjectsContaining(user)
            userRepo --> boardService : List<Project>
            boardService --> mainFrame : projects
            deactivate boardService
            
            mainFrame -> mainFrame : Ініціалізувати ProjectTreePanel
            mainFrame -> mainFrame : Показати дошки та задачі
        end
    end
end

deactivate loginFrame
deactivate launcher

@enduml 