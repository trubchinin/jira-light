@startuml bpmn_create_issue
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Arial

title Процес створення задачі (BPMN)

|Користувач|
start
:Відкрити MainFrame;
:Обрати проект з ProjectTreePanel;
:Натиснути кнопку "Створити задачу"\nабо клавішу Ctrl+N;

|MainFrame|
:Перевірити чи обрана дошка;
if (Дошка обрана?) then (так)
  :Створити новий об'єкт Issue;
  :Встановити status = TO_DO;
  :Відкрити IssueDialog(null, board, user);
else (ні)
  :Показати помилку\n"Оберіть дошку для перегляду";
  stop
endif

|IssueDialog|
:Показати форму створення;
:Встановити заголовок "Створити задачу";
:Ініціалізувати IssueCardModel;
:Заповнити поля за замовчуванням\n(Priority.MEDIUM, Status.TO_DO);

|Користувач|
:Заповнити назву задачі (обов'язково);
:Заповнити опис задачі;
:Вибрати пріоритет (HIGHEST, HIGH, MEDIUM, LOW, LOWEST);
:Вибрати виконавця;
:Натиснути "Зберегти";

|IssueDialog|
:Валідувати дані форми;
if (Дані валідні?) then (так)
  :Створити Issue з форми;
  :Викликати BoardService.createIssue();
else (ні)
  :Показати помилки валідації;
  :Фокус на першому невалідному полі;
  stop
endif

|BoardService|
:Отримати поточного користувача;
:Встановити reporter = currentUser;
:Зберегти Issue в репозиторії;
:Додати Issue до проекту;
:Повернути збережену Issue;

|IssueDialog|
:Встановити issueCreated = true;
:Закрити діалог;

|MainFrame|
:Оновити дошку (loadIssues);
:Додати сповіщення в NotificationPanel;
:Показати нову задачу в колонці TO_DO;

|Користувач|
:Побачити нову задачу на дошці;
stop

@enduml
