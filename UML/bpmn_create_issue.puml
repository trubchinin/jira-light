@startuml bpmn_create_issue
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam swimlaneWidth same

title Процес створення задачі (BPMN 2.0)

|#LightBlue|Користувач|
start
:Відкрити MainFrame;
note right
  Запуск головного вікна
  програми JiraLite
end note
:Обрати проект з\nProjectTreePanel;
:Натиснути "Створити задачу"\n(Ctrl+N);

|#LightGreen|MainFrame (System)|
if (Дошка обрана?) then (Так)
  :Створити новий\nоб'єкт Issue;
  :Встановити\nstatus = TO_DO;
  :Відкрити\nIssueDialog;
else (Ні)
  :Показати помилку\n"Оберіть дошку";
  stop
endif

|#LightCyan|IssueDialog|
:Показати форму\nстворення задачі;
:Ініціалізувати\nIssueCardModel;
:Встановити значення\nза замовчуванням;
note right
  Priority.MEDIUM
  Status.TO_DO
  Reporter = currentUser
end note

|#LightBlue|Користувач|
:Заповнити назву задачі\n(обов'язкове поле);
:Заповнити опис задачі;
:Вибрати пріоритет;
note right
  HIGHEST, HIGH, MEDIUM,
  LOW, LOWEST
end note
:Вибрати виконавця\n(за бажанням);
:Натиснути кнопку\n"Зберегти";

|#LightCyan|IssueDialog|
if (Валідація даних?) then (Успішно)
  :Створити Issue\nз даних форми;
  :Викликати BoardService.\ncreateIssue();
else (Помилка)
  :Показати помилки\nвалідації;
  :Встановити фокус на\nпершому невалідному полі;
  stop
endif

|#LightYellow|BoardService|
:Отримати поточного\nкористувача;
:Встановити\nreporter = currentUser;
:Зберегти Issue\nв репозиторії;
:Додати Issue\nдо проекту;
:Повернути збережену\nIssue з ID;

|#LightCyan|IssueDialog|
:Встановити\nissueCreated = true;
:Закрити діалог\n(dispose);

|#LightGreen|MainFrame (System)|
:Оновити дошку\n(loadIssues);
:Додати сповіщення в\nNotificationPanel;
:Показати нову задачу\nв колонці TO_DO;

|#LightBlue|Користувач|
:Побачити нову задачу\nна дошці;
note right
  Задача з'являється
  в колонці TO_DO
  з унікальним ID
end note
stop

legend right
  |= Колір |= Учасник |
  |<#LightBlue>| Користувач |
  |<#LightGreen>| UI Компоненти |
  |<#LightCyan>| Діалоги |
  |<#LightYellow>| Бізнес-логіка |
endlegend

@enduml
