@startuml use_case_diagram
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Arial

title Діаграма прецедентів JiraLite

left to right direction

actor "Адміністратор\n(ADMIN)" as Admin
actor "Користувач\n(USER)" as User  
actor "Гість\n(GUEST)" as Guest

rectangle "JiraLite System" {
  
  package "Автентифікація" {
    usecase "Вхід в систему" as UC1
    usecase "Вихід з системи" as UC2
    usecase "Перегляд профілю" as UC3
  }
  
  package "Проекти та дошки" {
    usecase "Переглянути проекти" as UC4
    usecase "Створити проект" as UC5
    usecase "Редагувати проект" as UC6
    usecase "Видалити проект" as UC7
    usecase "Переглянути дошку" as UC9
    usecase "Створити дошку" as UC10
    usecase "Оновити дошку" as UC11
  }
  
  package "Управління задачами" {
    usecase "Переглянути задачі" as UC13
    usecase "Створити задачу" as UC14
    usecase "Редагувати власну задачу" as UC15
    usecase "Редагувати будь-яку задачу" as UC16
    usecase "Видалити задачу" as UC17
    usecase "Змінити статус" as UC19
    usecase "Перемістити задачу" as UC12
  }
  
  package "Пошук та коментарі" {
    usecase "Пошук задач" as UC22
    usecase "Фільтрувати задачі" as UC23
    usecase "Додати коментар" as UC20
    usecase "Редагувати коментар" as UC21
    usecase "Призначити виконавця" as UC18
  }
  
  package "Налаштування" {
    usecase "Змінити тему" as UC26
    usecase "Змінити масштаб" as UC27
    usecase "Налаштувати сповіщення" as UC29
    usecase "Про програму" as UC30
  }
}

' Admin connections (скорочені лінії)
Admin --> UC1
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC16
Admin --> UC17

' User connections
User --> UC1
User --> UC4
User --> UC9
User --> UC14
User --> UC15
User --> UC19
User --> UC22

' Guest connections
Guest --> UC1
Guest --> UC4
Guest --> UC9
User --> UC13
Guest --> UC22

' Inheritance relationships
UC15 --> UC16 : <<extends>>
UC23 --> UC22 : <<extends>>

note top of Admin
  Повний доступ до системи
end note

note top of User
  Створення та редагування
  власних задач
end note

note top of Guest
  Тільки перегляд
end note

@enduml 