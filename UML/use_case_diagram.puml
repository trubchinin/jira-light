@startuml use_case_diagram
!theme blueprint

title Діаграма прецедентів JiraLite

left to right direction

actor "Адміністратор" as Admin
actor "Менеджер проекту" as PM  
actor "Розробник" as Dev
actor "Спостерігач" as Viewer

rectangle "JiraLite System" {
  
  package "Управління користувачами" {
    usecase "Авторизація" as UC1
    usecase "Створити користувача" as UC2
    usecase "Видалити користувача" as UC3
    usecase "Змінити роль" as UC4
    usecase "Переглянути профіль" as UC5
  }
  
  package "Управління проектами" {
    usecase "Створити проект" as UC6
    usecase "Редагувати проект" as UC7
    usecase "Видалити проект" as UC8
    usecase "Переглянути проекти" as UC9
    usecase "Додати учасника" as UC10
  }
  
  package "Управління дошками" {
    usecase "Створити дошку" as UC11
    usecase "Налаштувати колонки" as UC12
    usecase "Переглянути дошку" as UC13
  }
  
  package "Управління задачами" {
    usecase "Створити задачу" as UC14
    usecase "Редагувати задачу" as UC15
    usecase "Видалити задачу" as UC16
    usecase "Змінити статус" as UC17
    usecase "Призначити виконавця" as UC18
    usecase "Додати коментар" as UC19
    usecase "Пошук задач" as UC20
  }
  
  package "Налаштування" {
    usecase "Змінити тему" as UC21
    usecase "Змінити мову" as UC22
    usecase "Експорт даних" as UC23
  }
}

